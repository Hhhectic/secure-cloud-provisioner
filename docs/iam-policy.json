{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyAcrossEverythingThisToolAudits",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:ListBucket*",
        "s3:ListAllMyBuckets",
        "ec2:Describe*",
        "ssm:GetParameter",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RefuseEveryIamWrite",
      "Effect": "Deny",
      "Action": [
        "iam:Create*",
        "iam:Delete*",
        "iam:Update*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Detach*",
        "iam:Add*",
        "iam:Remove*",
        "iam:Deactivate*",
        "iam:Enable*",
        "iam:Resync*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:ChangePassword",
        "iam:UploadServerCertificate",
        "iam:UploadSigningCertificate",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ChangeBucketSettings",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucket*",
        "s3:PutEncryptionConfiguration",
        "s3:CreateBucket",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::*"
    },
    {
      "Sid": "EmptyBucketsForTeardown",
      "Effect": "Allow",
      "Action": "s3:DeleteObject*",
      "Resource": "arn:aws:s3:::*/*"
    },
    {
      "Sid": "ChangeNetworkAndCompute",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroup*",
        "ec2:ModifySecurityGroupRules",
        "ec2:CreateTags",
        "ec2:ImportKeyPair",
        "ec2:DeleteKeyPair",
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:*Vpc*",
        "ec2:*Subnet*",
        "ec2:*RouteTable*",
        "ec2:*Route",
        "ec2:*InternetGateway*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RefuseNatGatewaysWhichBillContinuously",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateNatGateway"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RefuseAnythingButTheSmallestInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "ForAnyValue:StringNotLike": {
          "ec2:InstanceType": ["*.nano", "*.micro", "*.small"]
        }
      }
    },
    {
      "Sid": "RefuseGeneratingPrivateKeys",
      "Effect": "Deny",
      "Action": "ec2:CreateKeyPair",
      "Resource": "*"
    }
  ]
}
