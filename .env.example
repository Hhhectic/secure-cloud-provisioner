# Copy this to `.env` at the repository root and fill in what you have.
#
#     cp .env.example .env
#
# `.env` is gitignored. Real environment variables always win over this file, so
# a shell export or a CI secret overrides it without editing anything.
#
# The two clouds are independent. Filling in only one is fine — the other's tabs
# report themselves unavailable and the rest of the page works. Leaving a
# variable blank is the same as leaving it out.

# --- AWS ------------------------------------------------------------------
# Not your admin user. This wants its own IAM identity with the two
# least-privilege policies in docs/iam-setup.md attached. If the tool hits a
# permission it does not have, it says which one by name.
#
# boto3 also reads ~/.aws/credentials on its own, so leave these blank if you
# already have a profile configured there.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Azure ----------------------------------------------------------------
# A service principal: `az ad sp create-for-rbac`. CLIENT_SECRET is the
# password it prints once and never shows again.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
