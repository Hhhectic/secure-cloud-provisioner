# Local virtual environment
.venv/
venv/

# Python cache & temporary files
__pycache__/
*.pyc
.pytest_cache/

# Credentials & secrets
#
# Not *.json. That was meant to catch downloaded credential files and instead
# caught docs/iam-policy.json, which is the one file a reader most needs and
# the one nobody would notice missing. It would take package.json with it the
# moment a frontend arrives. Name the shapes credentials actually come in.
.env
*.pem
*credentials*.json
*secret*.json
*accessKeys*.csv
.aws/

# Private keys the web page downloads. The browser chooses where they land,
# and if that is this folder then a secret is one `git add -A` from being
# published. These patterns match what frontend/keygen.js and the blueprint
# name their downloads.
id_ed25519*
id_rsa*
*-id_ed25519*
*-id_rsa*
*-bastion-key
*-private-key

# Windows writes these next to anything downloaded through a browser.
*:Zone.Identifier

# VS Code settings
.vscode/
